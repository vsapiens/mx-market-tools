{
  "name": "@mx-market/stocks",
  "version": "0.2.0",
  "description": "Full Mexican market catalog: 100+ BMV domestic stocks + 350+ SIC international stocks with ranked search",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc"
  },
  "keywords": [
    "bmv",
    "bolsa",
    "mexico",
    "stocks",
    "tickers",
    "sic"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vsapiens/mx-market-tools",
    "directory": "packages/stocks"
  }
}
